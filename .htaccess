# ─────────────────────────────────────────────────────────────────────────────
# Hello Corp — configuration Apache (hébergement mutualisé : LWS, OVH, o2switch…)
# Ce fichier est ignoré par GitHub Pages / Netlify / Vercel : le laisser ne pose
# aucun problème.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Encodage
AddDefaultCharset UTF-8

# 2. Page d'accueil
DirectoryIndex index.html index.php

# 3. Protection des fichiers sensibles (sauvegarde des demandes de contact)
<FilesMatch "\.(log|md|yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 4. Forcer le HTTPS et le domaine sans "www"
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# 5. Cache navigateur des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType image/webp          "access plus 30 days"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# 6. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# 7. En-têtes de sécurité de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
